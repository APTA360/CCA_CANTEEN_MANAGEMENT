<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Order <%= order.token %> — <%= brand.name %></title>
<link rel="stylesheet" href="/styles.css" />
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/menu" class="logo">
      <img src="<%= brand.logo %>" alt="<%= brand.name %>" class="logo-img" />
      <span class="logo-text">Prit Da <span class="logo-accent">Dhaba</span></span>
    </a>
    <nav class="site-nav">
      <a href="/menu" class="nav-link">Menu</a>
      <a href="/cart" class="nav-link">Cart</a>
      <a href="/orders/history" class="nav-link active">Orders</a>
    </nav>
  </div>
</header>

<main class="container main">
  <nav class="breadcrumb">
    <a href="/orders/history">Orders</a> › <span>Order <%= escapeHtml(order.token) %></span>
  </nav>

  <% if (confirmed) { %>
    <div class="success-banner">
      <strong>Order placed!</strong> Token #<span><%= escapeHtml(order.token) %></span> — show at counter.
    </div>
  <% } %>

  <div class="order-header card">
    <div>
      <div class="order-token">Token #<%= escapeHtml(order.token) %></div>
      <div class="order-meta"><%= order.customerName %> · <%= order.rollNumber %> · <%= new Date(order.createdAt).toLocaleString() %></div>
    </div>
    <div class="status-chip status-<%= order.status.toLowerCase() %>"><%= order.status %></div>
  </div>

  <div class="stepper-card card">
    <ol class="stepper" data-current="<%= order.status %>">
      <% statuses.forEach(function(st, idx) { %>
        <%
          const curIdx = statuses.indexOf(order.status);
          const isDone = idx <= curIdx;
          const isCur = idx === curIdx;
        %>
        <li class="step <%- isDone ? 'done' : '' %> <%- isCur ? 'current' : '' %>">
          <div class="step-bubble"><%= idx + 1 %></div>
          <div class="step-info">
            <div class="step-name"><%= st %></div>
            <% if (isDone && order.statusHistory && order.statusHistory.find(function(h){return h.status === st})) { %>
              <div class="step-time"><%= new Date(order.statusHistory.find(function(h){return h.status === st}).time).toLocaleTimeString() %></div>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ol>
  </div>

  <div class="card receipt-card">
    <h3 class="card-h">Items</h3>
    <% order.items.forEach(function(item) { %>
      <div class="mini-row">
        <span class="mini-name">
          <span class="veg-badge tiny <%= item.isVeg ? 'veg' : 'non-veg' %>"><span class="veg-dot"></span></span>
          <%= escapeHtml(item.name) %> <span class="mini-qty">× <%= item.qty %></span>
        </span>
        <span class="mini-price">₹<%= item.price * item.qty %></span>
      </div>
    <% }); %>
    <hr class="divider" />
    <div class="sum-row"><span>Subtotal</span><span>₹<%= order.total %></span></div>
    <div class="sum-row total"><span>Total</span><span>₹<%= order.total %></span></div>
    <div class="meta-grid">
      <div><span>Payment</span><strong>
        <% if (order.paymentMethod === 'cash') { %>
          💵 Cash
          <% if (order.paymentStatus === 'paid') { %>
            <span class="pay-chip paid">Paid</span>
          <% } else { %>
            <span class="pay-chip pending">Pending</span>
          <% } %>
        <% } else { %>
          💳 Card <span class="pay-chip paid">Paid</span>
        <% } %>
      </strong></div>
      <div><span>Serving</span><strong>
        <%= order.servingMode === 'individual' ? 'As ready' : 'All together' %>
      </strong></div>
    </div>
  </div>

  <div class="conf-actions">
    <a href="/menu" class="btn-secondary">Order more</a>
    <a href="/orders/history" class="btn-primary">All orders</a>
  </div>
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <span>© <%= new Date().getFullYear() %> <%= brand.name %></span>
    <span class="commit-hash">commit: <%= commitSha %></span>
  </div>
</footer>

</body>
</html>
