<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= brand.name %> — Menu</title>
<link rel="stylesheet" href="/styles.css" />
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/menu" class="logo">
      <img src="<%= brand.logo %>" alt="<%= brand.name %>" class="logo-img" />
      <span class="logo-text">Prit Da <span class="logo-accent">Dhaba</span></span>
    </a>
    <nav class="site-nav">
      <a href="/menu" class="nav-link <%- currentPath === '/menu' || currentPath === '/' ? 'active' : '' %>">Menu</a>
      <a href="/cart" class="nav-link <%- currentPath === '/cart' ? 'active' : '' %>">
        Cart
        <% if (cartCount > 0) { %>
          <span class="cart-badge"><%= cartCount %></span>
        <% } %>
      </a>
      <a href="/orders/history" class="nav-link <%- currentPath === '/orders/history' ? 'active' : '' %>">Orders</a>
    </nav>
  </div>
</header>

<main class="container main">
  <section class="hero scroll-reveal">
    <h1><%= brand.tagline %></h1>
    <p class="hero-sub">Order from Prit Da Dhaba — skip the line, grab a token.</p>
  </section>

  <div class="search-bar scroll-reveal">
    <input type="search" id="searchInput" placeholder="Search for dishes, snacks, drinks…" />
  </div>

  <div class="category-chips scroll-reveal" id="categoryChips">
    <% categories.forEach(function(cat) { %>
      <button class="chip <%- cat === 'All' ? 'active' : '' %>" data-category="<%= escapeHtml(cat) %>">
        <%= escapeHtml(cat) %>
      </button>
    <% }); %>
  </div>

  <div class="menu-grid" id="menuGrid">
    <% menu.forEach(function(item, idx) { %>
      <article class="food-card scroll-reveal"
               style="--reveal-delay: <%= (idx % 6) * 60 %>ms"
               data-category="<%= escapeHtml(item.category) %>"
               data-name="<%= escapeHtml(item.name.toLowerCase()) %>"
               data-id="<%= escapeHtml(item.id) %>"
               data-nutrition='<%= JSON.stringify(item.nutrition) %>'
               data-ingredients='<%= JSON.stringify(item.ingredients) %>'>
        <div class="card-media">
          <img src="<%= escapeHtml(item.image) %>" alt="<%= escapeHtml(item.name) %>" loading="lazy" />
          <div class="card-badge prep"><%= escapeHtml(item.prepTime) %></div>
          <% if (!item.available) { %>
            <div class="sold-out-overlay">
              <span>Sold out</span>
            </div>
          <% } %>
        </div>
        <div class="card-body">
          <div class="card-title-row">
            <h3 class="card-title"><%= escapeHtml(item.name) %></h3>
            <span class="veg-badge <%= item.isVeg ? 'veg' : 'non-veg' %>" title="<%= item.isVeg ? 'Vegetarian' : 'Non-vegetarian' %>">
              <span class="veg-dot"></span>
            </span>
          </div>
          <div class="card-meta">
            <span class="rating-chip">4.<%= Math.floor(Math.random() * 5) + 3 %></span>
            <span class="meta-sep">·</span>
            <span class="cat-tag"><%= escapeHtml(item.category) %></span>
          </div>
          <div class="card-bottom">
            <div class="price">₹<%= item.price %></div>
            <div class="card-actions">
              <div class="stepper" data-item-id="<%= escapeHtml(item.id) %>">
                <button type="button" class="step-btn minus" aria-label="Decrease">−</button>
                <span class="step-count">0</span>
                <button type="button" class="step-btn plus" aria-label="Increase">+</button>
              </div>
              <button type="button"
                      class="btn-primary add-to-cart"
                      data-item-id="<%= escapeHtml(item.id) %>"
                      <%= !item.available ? 'disabled' : '' %>>
                Add
              </button>
            </div>
          </div>
        </div>
      </article>
    <% }); %>
  </div>

  <div class="empty-state scroll-reveal" id="emptySearch" hidden>
    <div class="empty-emoji">🔍</div>
    <h3>No dishes match that search</h3>
    <p>Hmm, we couldn't find what you're looking for. Try a different keyword or clear the search.</p>
    <button class="btn-secondary" id="clearSearchBtn">Clear search</button>
  </div>
</main>

<% if (cartCount > 0) { %>
  <div class="sticky-cart-bar" id="stickyCartBar">
    <div class="container sticky-cart-inner">
      <div class="sticky-cart-info">
        <strong id="stickyCartCount"><%= cartCount %></strong>
        <span>item<%= cartCount !== 1 ? 's' : '' %> in cart</span>
      </div>
      <a href="/cart" class="btn-primary">View Cart →</a>
    </div>
  </div>
<% } else { %>
  <div class="sticky-cart-bar" id="stickyCartBar" hidden>
    <div class="container sticky-cart-inner">
      <div class="sticky-cart-info">
        <strong id="stickyCartCount">0</strong>
        <span>items in cart</span>
      </div>
      <a href="/cart" class="btn-primary">View Cart →</a>
    </div>
  </div>
<% } %>

<div class="nutri-popup" id="nutriPopup" hidden>
  <div class="nutri-popup-arrow"></div>
  <div class="nutri-popup-inner">
    <h4 class="nutri-name" id="nutriName"></h4>
    <div class="nutri-calories-row">
      <span class="nutri-cal-badge">🔥 <span id="nutriCalories">0</span> kcal</span>
    </div>
    <div class="nutri-grid">
      <div class="nutri-stat"><span class="nutri-label">Protein</span><span class="nutri-val" id="nutriProtein">0g</span></div>
      <div class="nutri-stat"><span class="nutri-label">Carbs</span><span class="nutri-val" id="nutriCarbs">0g</span></div>
      <div class="nutri-stat"><span class="nutri-label">Fat</span><span class="nutri-val" id="nutriFat">0g</span></div>
      <div class="nutri-stat"><span class="nutri-label">Fiber</span><span class="nutri-val" id="nutriFiber">0g</span></div>
    </div>
    <div class="nutri-section">
      <h5>Ingredients</h5>
      <ul class="nutri-ingredients" id="nutriIngredients"></ul>
    </div>
    <div class="nutri-allergens" id="nutriAllergensWrap" hidden>
      <h5>⚠️ Allergens</h5>
      <div class="nutri-allergen-tags" id="nutriAllergens"></div>
    </div>
  </div>
</div>

<footer class="site-footer">
  <div class="container footer-inner">
    <span>© <%= new Date().getFullYear() %> <%= brand.name %></span>
    <span class="commit-hash">commit: <%= commitSha %></span>
  </div>
</footer>

<script>
(function () {
  const chips = document.querySelectorAll('#categoryChips .chip');
  const cards = document.querySelectorAll('.food-card');
  const searchInput = document.getElementById('searchInput');
  const emptyEl = document.getElementById('emptySearch');
  const clearBtn = document.getElementById('clearSearchBtn');
  let activeCat = 'All';
  let searchTerm = '';

  function applyFilters() {
    let visible = 0;
    const term = searchTerm.trim().toLowerCase();
    cards.forEach(function (card) {
      const cat = card.dataset.category;
      const name = card.dataset.name;
      const catOk = activeCat === 'All' || cat === activeCat;
      const searchOk = !term || name.includes(term);
      const show = catOk && searchOk;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    emptyEl.hidden = visible > 0;
  }

  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      chips.forEach(function (c) { c.classList.remove('active'); });
      chip.classList.add('active');
      activeCat = chip.dataset.category;
      applyFilters();
    });
  });

  searchInput.addEventListener('input', function (e) {
    searchTerm = e.target.value;
    applyFilters();
  });

  clearBtn && clearBtn.addEventListener('click', function () {
    searchInput.value = '';
    searchTerm = '';
    applyFilters();
  });

  function getStepper(id) {
    return document.querySelector('.stepper[data-item-id="' + id + '"]');
  }
  function setStepperCount(id, n) {
    const s = getStepper(id);
    if (!s) return;
    s.querySelector('.step-count').textContent = n;
  }

  document.querySelectorAll('.stepper').forEach(function (s) {
    const id = s.dataset.itemId;
    const minus = s.querySelector('.minus');
    const plus = s.querySelector('.plus');
    const countEl = s.querySelector('.step-count');
    minus.addEventListener('click', function () {
      let n = parseInt(countEl.textContent, 10);
      if (n > 0) { n--; countEl.textContent = n; }
      if (n > 0) updateCart(id, n);
      else removeFromCartUI(id);
    });
    plus.addEventListener('click', function () {
      let n = parseInt(countEl.textContent, 10);
      n++; countEl.textContent = n;
      if (n === 1) addToCart(id, 1);
      else updateCart(id, n);
    });
  });

  document.querySelectorAll('.add-to-cart').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const id = btn.dataset.itemId;
      const s = getStepper(id);
      const cur = s ? parseInt(s.querySelector('.step-count').textContent, 10) : 0;
      if (cur === 0) {
        setStepperCount(id, 1);
        addToCart(id, 1);
      } else {
        setStepperCount(id, cur + 1);
        updateCart(id, cur + 1);
      }
    });
  });

  function updateBadgeCount(n) {
    const sticky = document.getElementById('stickyCartBar');
    document.querySelectorAll('.cart-badge').forEach(function (b) { b.textContent = n; });
    const cartBadges = document.querySelectorAll('.cart-badge');
    cartBadges.forEach(function (b) { b.style.display = n > 0 ? '' : 'none'; });
    document.getElementById('stickyCartCount').textContent = n;
    if (sticky) sticky.hidden = n <= 0;
  }

  function fetchJSON(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    }).then(function (r) {
      if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Request failed'); });
      return r.json();
    });
  }

  function addToCart(id, qty) {
    fetchJSON('/cart/add', { itemId: id, qty: qty })
      .then(function (d) { updateBadgeCount(d.cartCount); toast('Added to cart ✓'); })
      .catch(function (e) { toast(e.message, true); });
  }

  function updateCart(id, qty) {
    fetchJSON('/cart/update', { itemId: id, qty: qty })
      .then(function (d) { updateBadgeCount(d.cartCount); })
      .catch(function (e) { toast(e.message, true); });
  }

  function removeFromCartUI(id) {
    updateCart(id, 0);
  }

  function toast(msg, isErr) {
    let t = document.getElementById('toastEl');
    if (!t) {
      t = document.createElement('div');
      t.id = 'toastEl';
      t.className = 'toast';
      document.body.appendChild(t);
    }
    t.textContent = msg;
    t.classList.add('show', isErr ? 'err' : 'ok');
    t.classList.remove(isErr ? 'ok' : 'err');
    clearTimeout(t._t);
    t._t = setTimeout(function () { t.classList.remove('show'); }, 1800);
  }

  const popup = document.getElementById('nutriPopup');
  const nutriName = document.getElementById('nutriName');
  const nutriCalories = document.getElementById('nutriCalories');
  const nutriProtein = document.getElementById('nutriProtein');
  const nutriCarbs = document.getElementById('nutriCarbs');
  const nutriFat = document.getElementById('nutriFat');
  const nutriFiber = document.getElementById('nutriFiber');
  const nutriIngredients = document.getElementById('nutriIngredients');
  const nutriAllergensWrap = document.getElementById('nutriAllergensWrap');
  const nutriAllergens = document.getElementById('nutriAllergens');
  let hideTimer = null;

  function showPopup(card) {
    const name = card.querySelector('.card-title').textContent;
    const nut = JSON.parse(card.dataset.nutrition || '{}');
    const ing = JSON.parse(card.dataset.ingredients || '[]');

    nutriName.textContent = name;
    nutriCalories.textContent = nut.calories || 0;
    nutriProtein.textContent = (nut.protein || 0) + 'g';
    nutriCarbs.textContent = (nut.carbs || 0) + 'g';
    nutriFat.textContent = (nut.fat || 0) + 'g';
    nutriFiber.textContent = (nut.fiber || 0) + 'g';

    nutriIngredients.innerHTML = '';
    ing.forEach(function (i) {
      const li = document.createElement('li');
      li.textContent = i;
      nutriIngredients.appendChild(li);
    });

    nutriAllergens.innerHTML = '';
    const allergens = nut.allergens || [];
    if (allergens.length > 0) {
      allergens.forEach(function (a) {
        const tag = document.createElement('span');
        tag.className = 'nutri-allergen-tag';
        tag.textContent = a;
        nutriAllergens.appendChild(tag);
      });
      nutriAllergensWrap.hidden = false;
    } else {
      nutriAllergensWrap.hidden = true;
    }

    const rect = card.getBoundingClientRect();
    const viewW = window.innerWidth;
    const popupW = 320;
    let left = rect.left + rect.width / 2 - popupW / 2 + window.scrollX;
    let top = rect.bottom + 14 + window.scrollY;
    let arrowAlign = 'center';

    if (left + popupW > viewW + window.scrollX - 16) {
      left = viewW + window.scrollX - popupW - 16;
      arrowAlign = 'right';
    }
    if (left < window.scrollX + 16) {
      left = window.scrollX + 16;
      arrowAlign = 'left';
    }

    if (rect.bottom + 200 > window.innerHeight) {
      top = rect.top + window.scrollY - 14;
      popup.classList.add('popup-above');
    } else {
      popup.classList.remove('popup-above');
    }

    popup.style.left = left + 'px';
    popup.style.top = top + 'px';

    const arrow = popup.querySelector('.nutri-popup-arrow');
    if (arrowAlign === 'left') arrow.style.left = (rect.left - left + rect.width / 2) + 'px';
    else if (arrowAlign === 'right') arrow.style.left = (rect.left - left + rect.width / 2) + 'px';
    else arrow.style.left = '';

    popup.hidden = false;
    popup.classList.remove('popup-zoom-out');
    popup.classList.add('popup-zoom-in');
  }

  function hidePopup() {
    popup.classList.remove('popup-zoom-in');
    popup.classList.add('popup-zoom-out');
    clearTimeout(hideTimer);
    hideTimer = setTimeout(function () {
      popup.hidden = true;
    }, 160);
  }

  cards.forEach(function (card) {
    if (card.querySelector('.sold-out-overlay')) return;
    card.addEventListener('mouseenter', function () {
      clearTimeout(hideTimer);
      showPopup(card);
    });
    card.addEventListener('mouseleave', function () {
      hidePopup();
    });
  });

  const revealEls = document.querySelectorAll('.scroll-reveal');
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (ent) {
        if (ent.isIntersecting) {
          ent.target.classList.add('revealed');
          obs.unobserve(ent.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach(function (el) { obs.observe(el); });
  } else {
    revealEls.forEach(function (el) { el.classList.add('revealed'); });
  }
})();
</script>

</body>
</html>
